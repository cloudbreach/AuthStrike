# Required application secret. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=

# Admin username and password hash. Generate the hash with:
# python scripts/create_password_hash.py
AUTHSTRIKE_ADMIN_USERNAME=admin
AUTHSTRIKE_ADMIN_PASSWORD_HASH=


# Security / storage defaults
# Set true only when AuthStrike is served through HTTPS (e.g. Nginx on :443).
# For direct HTTP testing on :5000, leave this false.
AUTHSTRIKE_HTTPS=false
STORE_RAW_TOKENS=false
FLASK_DEBUG=false

# Local/direct Flask server settings (Gunicorn ignores these)
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
